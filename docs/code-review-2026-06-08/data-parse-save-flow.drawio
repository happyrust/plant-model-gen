        <!-- C -> storage -->
        <mxCell id="eC2D1" value="写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#8a64a8;fontSize=10;" edge="1" parent="1" source="C2" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
