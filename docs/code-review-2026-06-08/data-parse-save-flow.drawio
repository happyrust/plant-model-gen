        <mxCell id="C3" value="构建索引树 gen_index_tree&#10;tree_index_manager (rkyv 文件)&#10;+ db_meta_info.json (ref0→dbnum)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="460" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="C4" value="模型生成 gen_all_geos_data&#10;PRIM/CATE/LOOP 几何 · mesh&#10;manifold 布尔运算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="585" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="C5" value="写实例/几何/变换/包围盒&#10;inst_relate · geo_relate · trans · aabb&#10;pdms_inst_surreal / model_writer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="585" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="C6" value="导出 Parquet&#10;export_dbnum_instances_parquet&#10;(从 SurrealDB 读 → 多表 Parquet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="585" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== Band D ===================== -->
        <mxCell id="D1" value="SurrealDB&#10;PE · inst/geo relate&#10;trans · aabb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;shape=cylinder3;boundedLbl=1;" vertex="1" parent="1">
