        <mxCell id="C2" value="save_db? 保存 PE&#10;save_pes / save_pe_relates&#10;(→ SurrealDB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
