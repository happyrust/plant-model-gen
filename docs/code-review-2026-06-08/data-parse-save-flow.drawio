        <mxCell id="eB4C0" value="spawn aios-database -c &lt;config&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#cf8b00;fontSize=10;fontStyle=1;" edge="1" parent="1" source="B4" target="C0"><mxGeometry relative="1" as="geometry" /></mxCell>

