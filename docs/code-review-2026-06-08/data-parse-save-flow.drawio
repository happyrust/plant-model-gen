          <mxGeometry x="500" y="760" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="D4" value="SQLite&#10;RTree 空间索引&#10;+ db_index 依赖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;shape=cylinder3;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="760" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="D5" value="Parquet 文件组&#10;instances/geo_instances/transforms/&#10;aabb/ptsets/tubings + manifest.json&#10;→ 前端直接查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c4e3;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="755" width="280" height="100" as="geometry" />
