        <mxCell id="eC6D5" value="写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#8a64a8;fontSize=10;" edge="1" parent="1" source="C6" target="D5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- B3 -> SQLite db_index -->
        <mxCell id="eB3D4" value="db_index 写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#8a64a8;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="B3" target="D4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- legend -->
        <mxCell id="legend" value="图例：实线箭头 = 写/正向流　虚线箭头 = 读/可选/反馈　圆柱 = 持久化存储&#10;说明：①②④ 为常驻进程；③ 为每次解析任务派生的一次性 CLI 子进程（job 完成后自关闭）。&#10;真正的『解析 + 保存』发生在 ③ —— save_db 控制是否落 SurrealDB；gen_model / export_parquet 控制是否生成几何与导出列存。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=middle;fontSize=11;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
