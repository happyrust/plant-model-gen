<mxfile host="app.diagrams.net" agent="cursor" version="24.0.0">
  <diagram id="data-parse-save-flow" name="数据解析保存流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== Lane backgrounds ===================== -->
        <mxCell id="laneA" value="① 控制面 / 触发（web_server 进程）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingLeft=12;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="1240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="laneB" value="② Sidecar 进程（aios-database serve · src/parse_sidecar.rs · Bearer token 鉴权）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF6E9;strokeColor=#82b366;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingLeft=12;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="1240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="laneC" value="③ 主管线 CLI：aios-database -c &lt;config&gt;（DbOption.toml 驱动 · 真正的解析+生成+保存）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#d79b00;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingLeft=12;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="410" width="1240" height="290" as="geometry" />
        </mxCell>
        <mxCell id="laneD" value="④ 存储后端 / 产物" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3EEF8;strokeColor=#9673a6;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingLeft=12;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="720" width="1240" height="160" as="geometry" />
        </mxCell>

        <!-- ===================== Band A ===================== -->
        <mxCell id="A1" value="用户在 Admin UI 触发&#10;解析 / 部署 / 快测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="web_server&#10;admin_handlers · admin_task_handlers&#10;managed_project_sites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="parse_sidecar_client&#10;ensure_sidecar() → spawn sidecar&#10;HTTP/WS 代理调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== Band B ===================== -->
        <mxCell id="B1" value="POST /projects/scan&#10;扫描工程目录 · 读 60B 文件头&#10;parse_file_basic_info · dbnum 冲突检测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="POST /parse/preview-plan&#10;生成解析计划&#10;Full/Bootstrap/RebuildSystem/&#10;FastReparse/Selective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="290" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B3" value="POST /db-index/rebuild&#10;预扫 ref0 依赖 → DbIndexStore&#10;(spawn_blocking 两阶段)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="290" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="POST /jobs/submit-cli&#10;派生 CLI 子进程 + WS /events&#10;进度/日志/产物事件流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b9dcb4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="290" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- ===================== Band C (snake: C0→C1→C2→C3→C4→C5→C6) ===================== -->
        <mxCell id="C0" value="加载 DbOption.toml&#10;save_db / total_sync / gen_model&#10;gen_mesh / export_parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="C1" value="解析 PDMS .db&#10;PdmsIO parse_file_with_chunk&#10;versioned_db::sync_pdms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="460" width="250" height="70" as="geometry" />
