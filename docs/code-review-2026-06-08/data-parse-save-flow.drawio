        <mxCell id="eC5D1" value="写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#8a64a8;fontSize=10;" edge="1" parent="1" source="C5" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC5D3" value="可选写" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#8a64a8;fontSize=10;" edge="1" parent="1" source="C5" target="D3"><mxGeometry relative="1" as="geometry" /></mxCell>
