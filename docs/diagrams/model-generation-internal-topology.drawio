<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" agent="Cursor" version="26.0.0" type="device">
  <diagram id="genpipeline-internal-topology" name="GenPipeline 内部管线拓扑">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="GenPipeline 内部拓扑：几何生成阶段 → flume 通道 → 并发写入管线" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p2-laneA" value="几何生成阶段（stage 顺序执行，stage 内按 batch 并发）" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="520" height="880" as="geometry" />
        </mxCell>
        <mxCell id="p2-targets" value="GenerationTargets&#xa;bran_hang / loop / cate / prim / delete&#xa;target_hash 参与 provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="p2-laneA">
          <mxGeometry x="20" y="45" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-s1" value="① BRAN / HANG（优先）&#xa;收集 BRAN 子件 → 构建 cata_hash_map&#xa;→ gen_cata_instances_versioned&#xa;→ 收集 tubi_info → gen_branch_tubi&#xa;任一子阶段失败即上抛，不静默降级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="p2-laneA">
          <mxGeometry x="20" y="170" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2-s2" value="② LOOP&#xa;process_loop_refno_page&#xa;产出 loop_sjus_map 供 CATE 复用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-laneA">
          <mxGeometry x="20" y="350" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-s3" value="③ CATE&#xa;process_cate_refno_page&#xa;跳过 BRAN 已生成的子件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-laneA">
          <mxGeometry x="20" y="480" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-s4" value="④ PRIM&#xa;process_prim_refno_page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-laneA">
          <mxGeometry x="20" y="610" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-note-stage" value="所有输入只能来自 GenerationReadContext 预载快照；边界测试禁止管线内出现裸 SQL 与全局读取。生成阶段不直接写库，只向通道投递批次。" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;spacingLeft=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="p2-laneA">
          <mxGeometry x="20" y="740" width="480" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p2-chan" value="flume::bounded&#xa;channel_capacity&#xa;&#xa;ShapeInstancesData&#xa;批次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="100" height="520" as="geometry" />
        </mxCell>

        <mxCell id="p2-laneB" value="ModelWritePipeline（并发 worker 池 + batch barrier）" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="740" y="80" width="920" height="880" as="geometry" />
        </mxCell>
        <mxCell id="p2-precleanup" value="pipeline 启动前（仅增量）&#xa;pre_cleanup_for_regen_versioned&#xa;按旧模型水位切面清理目标及后代" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="p2-laneB">
          <mxGeometry x="560" y="150" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-sink" value="batch sink&#xa;编号分批 · 记录 touched refno&#xa;写入 GenerationArtifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="p2-laneB">
          <mxGeometry x="20" y="150" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-base" value="base writer 池&#xa;write_base_batch&#xa;+ persist_pe_transform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-laneB">
          <mxGeometry x="20" y="310" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-mesh" value="mesh stage 池&#xa;extract_mesh_tasks&#xa;缓存去重 + 新网格生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-laneB">
          <mxGeometry x="390" y="310" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-join" value="BatchStageJoiner&#xa;按 batch_id 汇合 base 指标与 mesh 结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2-laneB">
          <mxGeometry x="200" y="460" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-aabb" value="inst_aabb writer 池&#xa;persist_mesh_results&#xa;+ persist_inst_relate_aabb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2-laneB">
          <mxGeometry x="200" y="600" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-barrier" value="finish() barrier&#xa;等齐全部 batch → 最终 AABB sweep&#xa;→ 缺失 NEG 关系补偿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="p2-laneB">
          <mxGeometry x="200" y="750" width="330" height="100" as="geometry" />
