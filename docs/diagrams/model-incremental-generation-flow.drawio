        <mxCell id="e-commit-store" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="version-commit" target="data-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-store-debt" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="data-store" target="debt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-debt-analyze" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="debt" target="analyze">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="650" />
              <mxPoint x="740" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-analyze-coverage" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;" edge="1" parent="1" source="analyze" target="coverage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-coverage-generate" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="coverage" target="generate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-coverage-gap" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.25;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="coverage" target="full-regen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-generate-finalize" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="generate" target="finalize">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
