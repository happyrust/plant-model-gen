        <mxCell id="invariant" value="关键语义：data anchor 与 model_gen anchor 分离；模型生成失败不会回滚已提交数据，未消费的 model_gen_debt 会保留供后续追平。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
