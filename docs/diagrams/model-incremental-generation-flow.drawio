<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Cursor" version="29.7.9" type="device">
  <diagram id="model-incremental-generation" name="模型增量生成流程">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="模型增量生成流程（当前实现）" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="660" height="40" as="geometry" />
        </mxCell>

        <mxCell id="trigger-lane" value="触发与采集" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="260" height="620" as="geometry" />
        </mxCell>
        <mxCell id="trigger" value="CLI / Watch / HTTP&#xa;统一进入 run_increment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="trigger-lane">
          <mxGeometry x="40" y="50" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="watermark" value="读取 Committed Watermark&#xa;data anchor 优先&#xa;legacy sesno 回退" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="trigger-lane">
          <mxGeometry x="40" y="160" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="collect" value="读取 PDMS 增量&#xa;watermark + 1 → latest&#xa;分类受影响 refno" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="trigger-lane">
          <mxGeometry x="40" y="300" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="watch-note" value="Watch 即使没有新 sesno，&#xa;也会继续检查并追平模型欠账" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="trigger-lane">
          <mxGeometry x="30" y="460" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="commit-lane" value="数据提交" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="380" height="620" as="geometry" />
        </mxCell>
        <mxCell id="hash-gate" value="源文件 SHA-256 门禁&#xa;采集前后必须一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="commit-lane">
          <mxGeometry x="70" y="50" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="version-commit" value="Version Commit&#xa;dbnum 租约 + 连续性检查&#xa;指纹幂等 / Pending 恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="commit-lane">
          <mxGeometry x="60" y="170" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="data-store" value="写入 PE / ATT / pe_owner&#xa;发布 incremental data anchor" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="commit-lane">
          <mxGeometry x="70" y="320" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="debt" value="写入 model_gen_debt&#xa;记录本次模型影响范围（幂等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="commit-lane">
          <mxGeometry x="70" y="480" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="generation-lane" value="模型生成与追平" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="760" y="90" width="560" height="620" as="geometry" />
        </mxCell>
        <mxCell id="analyze" value="分析未消费欠账&#xa;合并连续区间与 refno" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="generation-lane">
          <mxGeometry x="40" y="60" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="coverage" value="欠账连续覆盖&#xa;data watermark？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="generation-lane">
          <mxGeometry x="320" y="65" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="full-regen" value="存在区间洞&#xa;停止自动生成&#xa;显式 --allow-full-regen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="generation-lane">
          <mxGeometry x="40" y="240" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="generate" value="增量生成模型&#xa;gen_all_geos_data&#xa;可选 Parquet 后处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="generation-lane">
          <mxGeometry x="300" y="220" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="retry" value="生成失败&#xa;数据不回滚，欠账保留&#xa;后续 Watch / CLI 再追平" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="generation-lane">
          <mxGeometry x="40" y="410" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="finalize" value="原子完成&#xa;发布 model_gen anchor&#xa;标记 debt 已消费" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="generation-lane">
          <mxGeometry x="300" y="400" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="done" value="模型版本追平 data watermark" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="generation-lane">
          <mxGeometry x="300" y="540" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e-trigger-watermark" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="trigger" target="watermark">
          <mxGeometry relative="1" as="geometry" />
