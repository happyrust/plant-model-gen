        <mxCell id="e-hash-commit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;" edge="1" parent="1" source="hash-gate" target="version-commit">
          <mxGeometry relative="1" as="geometry" />
