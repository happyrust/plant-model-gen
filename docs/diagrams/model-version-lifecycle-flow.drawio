        <mxCell id="egap_4" value="受控修复" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;fontStyle=2;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="cgap" target="c4">
