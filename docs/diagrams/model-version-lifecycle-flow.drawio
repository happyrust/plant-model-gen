<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" agent="Cursor" version="26.0.0" type="device">
  <diagram id="model-version-lifecycle" name="模型版本全生命周期">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="模型版本全生命周期流程（当前实现 · specs 022/024/026/027 收敛后）" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="1120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="laneA" value="阶段一 · 初始化建站（一次性 · staging 目录）" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="320" height="880" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="① 新建 staging 数据目录&#xa;versioned=true · retention=0" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneA">
          <mxGeometry x="25" y="45" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="② 初始化解析&#xa;读取稳定最新态&#xa;SHA-256 前后指纹门禁&#xa;（不写数据锚点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA">
          <mxGeometry x="25" y="155" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="③ 数据完整性校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA">
          <mxGeometry x="55" y="275" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="④ 首次全量模型生成&#xa;活读 staging 当前态&#xa;不绑定生成读取时刻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA">
          <mxGeometry x="25" y="360" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="⑤ 发布 model_gen 起点锚点&#xa;sesno = dbnum_info 当前值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="laneA">
          <mxGeometry x="35" y="465" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="全部成功?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="laneA">
          <mxGeometry x="90" y="565" width="140" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="⑥ 原子切换为正式站点&#xa;（进入常驻增量）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="laneA">
          <mxGeometry x="30" y="690" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="任一步失败 → staging 作废&#xa;必须用新目录重来（不得原地重试）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="790" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="laneB" value="阶段二 · 增量采集 → 数据版本提交（watch / CLI 常驻）" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="360" height="880" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="① 触发 run_increment&#xa;CLI incremental-sesno / watch-incremental / HTTP&#xa;（全程持项目 mutation lock）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="laneB">
          <mxGeometry x="20" y="45" width="320" height="85" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="② 读取 Committed Watermark&#xa;data anchor 优先 · 回退 dbnum_info" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneB">
          <mxGeometry x="25" y="155" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="③ 采集增量 watermark+1 → latest&#xa;5 桶分类 (prim/loop/bran/cata/delete)&#xa;+ 属性影响过滤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneB">
          <mxGeometry x="25" y="260" width="310" height="85" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="④ 源文件 SHA-256 门禁&#xa;采集前后必须一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneB">
          <mxGeometry x="50" y="370" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="⑤ Version Commit&#xa;dbnum lease · 连续性门禁&#xa;指纹幂等 / Pending 恢复&#xa;首次增量先写 incremental_baseline 锚点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="laneB">
          <mxGeometry x="25" y="455" width="310" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="⑥ 写 PE / ATT / pe_owner&#xa;发布 incremental data anchor" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="laneB">
          <mxGeometry x="25" y="580" width="310" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="⑦ 同事务写 model_gen_debt&#xa;5 桶 refno + [from, to] 闭区间（幂等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneB">
          <mxGeometry x="25" y="695" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bnote" value="watch 常驻：即使源无新 sesno，&#xa;每轮仍比对数据水位与模型水位，&#xa;消费连续欠账追平模型" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="laneB">
          <mxGeometry x="30" y="790" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="laneC" value="阶段三 · 模型生成与欠账追平（每 dbnum · 可自愈重试）" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="640" height="880" as="geometry" />
        </mxCell>
        <mxCell id="cb" value="数据与欠账&#xa;全部成功?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="laneC">
          <mxGeometry x="160" y="45" width="170" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cskip" value="否：跳过本轮模型生成&#xa;已提交数据保留 · 不发 model_gen&#xa;欠账留待下一轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneC">
          <mxGeometry x="400" y="45" width="225" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="① 分析 model_gen_debt&#xa;合并连续区间 + refno 桶" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneC">
          <mxGeometry x="140" y="180" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="② 欠账连续覆盖&#xa;至 data watermark?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="laneC">
          <mxGeometry x="160" y="290" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cgap" value="否：有洞 needs_full_regen&#xa;禁止 watch 自动整库重建 · 仅告警&#xa;→ 受控 catch-up / repair&#xa;（绑定既有数据锚点 · --allow-full-regen）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneC">
          <mxGeometry x="410" y="295" width="225" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="③ 增量生成 gen_all_geos_data&#xa;统一 VERSION AT（生成读取时刻）&#xa;pre_cleanup + 可选 Parquet 后处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="laneC">
          <mxGeometry x="140" y="440" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="生成成功?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="laneC">
          <mxGeometry x="160" y="585" width="170" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cfail" value="失败：数据不回滚&#xa;欠账保留 · per-dbnum 隔离&#xa;下轮 watch / CLI 再追平（自愈）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneC">
          <mxGeometry x="410" y="588" width="225" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="④ 原子收尾&#xa;发布 model_gen anchor (sesno = data watermark)&#xa;标记 debt 已消费 · 追加 model_generation_run 审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="laneC">
          <mxGeometry x="138" y="710" width="214" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cspecial" value="特例（不进几何生成、直接推进模型水位）&#xa;• 模型中性变更 → 发 no-op model_gen 锚点&#xa;• 纯删除 → 清理产物后照发锚点&#xa;（VERSION AT 旧锚点仍可见删除前模型）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="laneC">
          <mxGeometry x="400" y="710" width="235" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="模型版本追平 data watermark" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="laneC">
          <mxGeometry x="145" y="825" width="200" height="48" as="geometry" />
        </mxCell>

        <mxCell id="laneD" value="阶段四 · 历史查询与交付（读侧 · 只认锚点）" style="swimlane;startSize=32;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1420" y="80" width="380" height="880" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="读历史（CLI）&#xa;model-version history / model-snapshot / model-diff&#xa;按 (dbnum, sesno)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="45" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="VERSION AT（Surreal MVCC）&#xa;e3d_tree_api 按 sesno 查询模型 / 层级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="160" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="交付导出&#xa;model-version export --dbnum --sesno&#xa;从 model_gen 锚点即时导出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="265" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="最小交付单元&#xa;unit-export → model_unit_commit 台账&#xa;(dbnum, unit_refno, sesno)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="375" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="retention 窗口外 → HistoryExpired&#xa;提示改用源 db 文件重扫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="485" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="danchor" value="锚点体系 sesno_version_anchor&#xa;• data 锚点：full(只读) / incremental_baseline / incremental&#xa;• model 锚点：model_gen（模型生成水位）&#xa;数据查询只解析 data anchor；&#xa;模型查询 / 导出只解析 model_gen anchor" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="580" width="340" height="140" as="geometry" />
        </mxCell>

        <mxCell id="inv" value="关键不变式：① data anchor 与 model_gen anchor 分离——模型生成失败不回滚已提交数据，未消费的 model_gen_debt 保留供后续追平（自愈）；② Committed Watermark 是增量唯一合法起点；③ 项目 mutation lock + per-dbnum lease 串行化写入；④ versioned 为建库属性，切换须新目录重灌；⑤ 正式站点拒绝任意 generate/regen，只允许绑定既有数据锚点、写运行审计的受控 catch-up / repair。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="985" width="1760" height="90" as="geometry" />
        </mxCell>

