        <mxCell id="7" value="定位内部流水线背压&#xa;pending_mesh_outputs 长期贴近 108&#xa;producer send_wait_ms 秒级" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
