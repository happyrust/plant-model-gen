          <mxGeometry x="580" y="320" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="5" value="否：D 盘约 163GB 空闲&#xa;内存约 21GB 可用&#xa;CPU 约 30%-47%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="180" y="500" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="6" value="是：先处理机器资源问题&#xa;（本次证据不支持此分支）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="500" width="320" height="90" as="geometry" />
