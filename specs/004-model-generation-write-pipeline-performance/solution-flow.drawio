        <mxCell id="10" value="是写库端&#xa;base_write_ms 可到 33s&#xa;inst_aabb_ms 可到 35s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
